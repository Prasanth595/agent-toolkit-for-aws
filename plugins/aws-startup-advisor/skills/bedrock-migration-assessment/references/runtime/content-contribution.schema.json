{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMA content contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bucket",
    "source_order",
    "target",
    "kind",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ai\\."
    },
    "bucket": {
      "type": "integer"
    },
    "source_order": {
      "type": "integer"
    },
    "target": {
      "enum": [
        "DECISION.md",
        "decision-report.html",
        "MIGRATION_GUIDE.md",
        "README.md",
        "migration-report.html"
      ]
    },
    "kind": {
      "enum": [
        "step",
        "rollback_addition",
        "catalog_row",
        "table_row",
        "callout",
        "subsection"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "links",
        "traceability"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:^|\\n)[ \\t]{0,3}(?:#{1,6}(?:[ \\t]|$)|(?:=+|-+)[ \\t]*(?:\\n|$)))(?![\\s\\S]*!?\\[[^\\]\\n]*\\]\\s*\\()(?![\\s\\S]*(?:^|\\n)[ \\t]*\\[[^\\]\\n]+\\]:)(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.))[^<>]*$"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "href"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^<>\\[\\]\\r\\n]+$"
              },
              "href": {
                "type": "string",
                "oneOf": [
                  {
                    "pattern": "^https://[^\\s/@:?#]+(?::[0-9]+)?(?:/[^\\s]*)?$"
                  },
                  {
                    "pattern": "^#[a-z0-9][a-z0-9-]*$"
                  }
                ]
              }
            }
          }
        },
        "traceability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "source_service",
            "model",
            "call_sites"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "source_service": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "call_sites": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "line"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "MIGRATION_GUIDE.md"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "step",
              "rollback_addition",
              "table_row",
              "callout",
              "subsection"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "README.md"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "catalog_row",
              "table_row",
              "callout",
              "subsection"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "enum": [
              "DECISION.md",
              "decision-report.html",
              "migration-report.html"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "table_row",
              "callout",
              "subsection"
            ]
          }
        }
      }
    }
  ]
}
